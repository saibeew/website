DATABASE_URL=postgres://user:password@host:5432/database
POSTGRES_SSL=true
POSTGRES_POOL_MAX=10
AUTH_SESSION_DAYS=7
DEFAULT_INITIAL_BALANCE=10000
NEXT_PUBLIC_DEFAULT_INITIAL_BALANCE=10000
NEXT_PUBLIC_ENABLE_DEMO_DATA=false
NEXT_PUBLIC_APP_URL=https://beew.ai

# At least one AI provider is required.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required for email verification and password recovery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=beew.ai <onboarding@beew.ai>

# Required for Telegram publishing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WAR_ROOM_URL=
# Generate at least 32 cryptographically random bytes and share it only with the private trading worker.
TRADING_WORKER_API_KEY=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# Local terminal processing must remain disabled on hosted production.
ENABLE_LOCAL_STUDIO_PROCESSING=false
MT4_TERMINAL_EXE=
MT4_DATA_PATH=
MT5_TERMINAL_EXE=
MT5_DATA_PATH=
